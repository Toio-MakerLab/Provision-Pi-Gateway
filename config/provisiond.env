WIFI_INTERFACE=wlan0
WIFI_PROFILE=device-wifi

AP_PROFILE=device-provision-ap
AP_SSID=Gateway-Setup
AP_PASSWORD=GatewaySetup
AP_ADDRESS=192.168.12.1
# Bind on all interfaces, not just AP_ADDRESS: once Wi-Fi connects and the AP goes
# down, 192.168.12.1 no longer exists on wlan0, so binding to it specifically would
# make the server unable to start at all in normal (connected) operation. AP clients
# still reach the portal at http://192.168.12.1 via the nftables port 80->8080
# redirect, which is scoped to the AP interface/address regardless of this bind.
HTTP_ADDRESS=:8080

CONNECT_TIMEOUT=35s # Thời gian chờ để kết nối WiFi. Nếu không kết nối được, thiết bị sẽ khởi động lại.
RETRY_TIMEOUT=25s # Thời gian chờ giữa các lần thử kết nối WiFi. Nếu không kết nối được, thiết bị sẽ khởi động lại.
RESET_FLAG=/boot/firmware/RESET_WIFI

# Chỉ bật nếu API reboot là cần thiết.
ALLOW_REBOOT=false

# Đặt chuỗi ngẫu nhiên tối thiểu 32 ký tự nếu muốn bật endpoint reset network.
# Tạo bằng: openssl rand -hex 32
ADMIN_TOKEN=f24916c4b7a3d09c69b5ad78fbe39acaf280dd04284cd952da9972c759f1fdac

# OLED status display (SSD1306 128x64 qua I2C). Hiển thị SSID/IP hiện tại để
# không cần SSH/HDMI để đọc địa chỉ IP của thiết bị.
OLED_ENABLED=true
# Để trống để dùng bus I2C mặc định (thường là /dev/i2c-1 trên Raspberry Pi).
OLED_I2C_BUS=
# Hầu hết module SSD1306 dùng 0x3C, một số dùng 0x3D. Chạy `i2cdetect -y 1` trên
# Pi để xác định địa chỉ thực tế nếu màn hình không lên.
OLED_I2C_ADDRESS=0x3C
OLED_WIDTH=128
OLED_HEIGHT=64
OLED_REFRESH=5s
