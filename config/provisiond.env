WIFI_INTERFACE=wlan0
WIFI_PROFILE=device-wifi

AP_PROFILE=device-provision-ap
AP_SSID=Gateway-Setup
AP_PASSWORD=GatewaySetup
AP_ADDRESS=192.168.12.1
HTTP_ADDRESS=192.168.12.1:8080

CONNECT_TIMEOUT=35s # Thời gian chờ để kết nối WiFi. Nếu không kết nối được, thiết bị sẽ khởi động lại.
RETRY_TIMEOUT=25s # Thời gian chờ giữa các lần thử kết nối WiFi. Nếu không kết nối được, thiết bị sẽ khởi động lại.
RESET_FLAG=/boot/firmware/RESET_WIFI

# Chỉ bật nếu API reboot là cần thiết.
ALLOW_REBOOT=false

# Đặt chuỗi ngẫu nhiên tối thiểu 32 ký tự nếu muốn bật endpoint reset network.
# Tạo bằng: openssl rand -hex 32
ADMIN_TOKEN=

# OLED status display (SSD1306 128x64 qua I2C). Hiển thị SSID/IP hiện tại để
# không cần SSH/HDMI để đọc địa chỉ IP của thiết bị.
OLED_ENABLED=true
# Để trống để dùng bus I2C mặc định (thường là /dev/i2c-1 trên Raspberry Pi).
OLED_I2C_BUS=
OLED_WIDTH=128
OLED_HEIGHT=64
OLED_REFRESH=5s
